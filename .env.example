# beambam settings as a .env file. Copy to `~/.x2d/.env` (the config dir) to apply
# everywhere, or put it anywhere and point BEAMBAM_ENV_FILE at it. A `.env` in the current
# directory is NOT read automatically (another project's .env could otherwise redirect your
# printer's access code). Only X2D_* and BEAMBAM_* keys are read; variables already set in the
# environment win. See beambam/paths.py.

# Printer (LAN). Access code + serial: printer screen > Settings > Network / Device.
X2D_IP=192.168.1.42
X2D_CODE=12345678
X2D_SERIAL=0309DA000000000

# Pick a [printer:NAME] section of the credentials INI instead of the values above.
# X2D_PRINTER=studio

# Bambu account user id embedded in signed print-control commands (X2D/H2D). Normally read
# from cloud_session.json after `beambam cloud-login`; set it here to stay fully offline.
# X2D_USER_ID=1234567890

# Where beambam keeps its state (credentials INI, signing key, cert id, queue, cloud session).
# BEAMBAM_HOME=~/.x2d
# Credentials INI path, if not <BEAMBAM_HOME>/credentials.
# BEAMBAM_CREDS=~/.x2d/credentials
