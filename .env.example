# beambam settings as a .env file. Copy to `.env` (git-ignored) in the directory you run
# beambam from, or to `~/.x2d/.env` to apply everywhere. Only X2D_* and BEAMBAM_* keys are
# read; variables already set in the environment win. See beambam/paths.py.

# Printer (LAN). Access code + serial: printer screen > Settings > Network / Device.
X2D_IP=192.168.1.42
X2D_CODE=12345678
X2D_SERIAL=0309DA000000000

# Pick a [printer:NAME] section of the credentials INI instead of the values above.
# X2D_PRINTER=studio

# Where beambam keeps its state (credentials INI, signing key, cert id, queue, cloud session).
# BEAMBAM_HOME=~/.x2d
# Credentials INI path, if not <BEAMBAM_HOME>/credentials.
# BEAMBAM_CREDS=~/.x2d/credentials
