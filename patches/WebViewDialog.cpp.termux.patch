@@ -159,6 +163,27 @@ WebViewPanel::WebViewPanel(wxWindow *parent)
     left_group->Add(m_online_back_btn, 0, wxALIGN_CENTER_VERTICAL | wxRIGHT, FromDIP(12));
     left_group->Add(m_online_refresh_btn, 0, wxALIGN_CENTER_VERTICAL | wxRIGHT, FromDIP(12));
 
+    // x2d/termux #81 — quick-launch buttons that load Printables (Prusaverse)
+    // and Thingiverse in the same online webview alongside MakerWorld. Both
+    // sites have public model browsing; loading them in-app saves a hop to
+    // the system browser. Buttons reuse the existing "open_in_browser"
+    // glyph as a generic external-site icon — swap for site-specific
+    // bitmaps if/when they get bundled with the Termux build.
+    auto *m_online_printables_btn = make_online_toolbar_button(
+        "open_in_browser", _L("Browse Printables (Prusaverse)"));
+    auto *m_online_thingiverse_btn = make_online_toolbar_button(
+        "open_in_browser", _L("Browse Thingiverse"));
+    left_group->Add(m_online_printables_btn,   0, wxALIGN_CENTER_VERTICAL | wxRIGHT, FromDIP(12));
+    left_group->Add(m_online_thingiverse_btn,  0, wxALIGN_CENTER_VERTICAL | wxRIGHT, FromDIP(12));
+    m_online_printables_btn->Bind(wxEVT_BUTTON, [this](wxCommandEvent&) {
+        if (m_browser) m_browser->LoadURL("https://www.printables.com/");
+    });
+    m_online_thingiverse_btn->Bind(wxEVT_BUTTON, [this](wxCommandEvent&) {
+        if (m_browser) m_browser->LoadURL("https://www.thingiverse.com/");
+    });
+    m_online_printables_btn->Enable(true);
+    m_online_thingiverse_btn->Enable(true);
+
     m_online_open_browser_btn = make_online_toolbar_button("open_in_browser", _L("Open in browser"));
     right_group->Add(m_online_open_browser_btn, 0, wxALIGN_CENTER_VERTICAL);
 
@@ -1471,6 +1496,44 @@ void WebViewPanel::OnNavigationRequest(wxWebViewEvent& evt)
             surl.EndsWith("bbsflmt")
             )
         {
+            // x2d/termux #82 — model-site downloads: try in-app import
+            // first via the x2d_bridge `fetch` CLI (handles MakerWorld /
+            // Printables / Thingiverse URL formats and emits the saved
+            // local file paths as JSON to stdout). Falls back to
+            // external browser if the bridge isn't reachable.
+            const wxString surl_lo = surl.Lower();
+            const bool is_model_site =
+                surl_lo.Contains("makerworld.com")  ||
+                surl_lo.Contains("printables.com")  ||
+                surl_lo.Contains("thingiverse.com");
+            if (is_model_site) {
+                const wxString dl_dir = wxFileName::GetTempDir() + "/x2d_dl";
+                wxFileName::Mkdir(dl_dir, 0700, wxPATH_MKDIR_FULL);
+                const wxString cmd = wxString::Format(
+                    "python3.12 %s/x2d_bridge.py fetch %s --out-dir %s --json",
+                    wxGetenv("X2D_REPO") ? wxGetenv("X2D_REPO")
+                                         : wxString(getenv("HOME") ? getenv("HOME") : "")
+                                           + "/git/x2d",
+                    url, dl_dir);
+                wxArrayString out_lines, err_lines;
+                long rc = wxExecute(cmd, out_lines, err_lines, wxEXEC_SYNC);
+                if (rc == 0) {
+                    wxArrayString files;
+                    wxDir::GetAllFiles(dl_dir, &files,
+                        "*.3mf", wxDIR_FILES);
+                    if (files.IsEmpty()) {
+                        wxDir::GetAllFiles(dl_dir, &files,
+                            "*.stl", wxDIR_FILES);
+                    }
+                    if (!files.IsEmpty()) {
+                        wxGetApp().plater()->load_files(files);
+                        evt.Veto();
+                        return;
+                    }
+                }
+                // bridge unavailable or download produced no files → fall
+                // through to external-browser handling, preserving old UX.
+            }
             wxLaunchDefaultBrowser(url);
 
             evt.Veto();
